# Separate database per environment: marq_dev locally, marq_prod on Vercel. Never KLOOP's database.
MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/marq_prod
# openssl rand -base64 48
SESSION_SECRET=
# Base URL used in activation / reset links
APP_URL=https://marq.klef.me
# Seed-only: first Super Administrator
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
# Optional SMTP: enables emailed invitations and "Forgot password". Without it, admins copy one-time links.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="MARQ · KL University <marq@marq.klef.me>"
CRON_SECRET=
# Optional: reserved for GitHub profile data (not used yet)
GITHUB_TOKEN=
